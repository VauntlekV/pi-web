{
  "name": "pi-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web UI for the pi coding agent, embedding the pi SDK in-process (Claude Desktop style)",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@hono/node-server": "2.1.5",
    "highlight.js": "^11.12.0",
    "hono": "4.13.14",
    "lucide-react": "^1.63.0",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
