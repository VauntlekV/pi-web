{
  "name": "@vauntlek/pi-web",
  "version": "0.1.1",
  "description": "Web UI for the pi coding agent: embeds the pi SDK in-process, Claude-style interface, LAN access with token auth",
  "keywords": [
    "pi",
    "pi-agent",
    "coding-agent",
    "ai",
    "agent",
    "web-ui",
    "llm",
    "claude-style"
  ],
  "homepage": "https://github.com/VauntlekV/pi-web#readme",
  "bugs": {
    "url": "https://github.com/VauntlekV/pi-web/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VauntlekV/pi-web.git"
  },
  "license": "MIT",
  "author": "Vauntlek",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin/",
    "dist/",
    "!dist/**/*.map",
    "!dist/server/server/testing.js",
    "!dist/server/server/settings/testing.js",
    "docs/THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:demo": "vite build --mode demo --base /pi-web/ --outDir ../dist/pages --emptyOutDir && FAUX_TPS=120 tsx demo/record.ts dist/pages/demo-data.json && cp dist/pages/index.html dist/pages/404.html",
    "start": "node dist/server/server/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test:e2e": "npm run build:web && playwright test",
    "preversion": "node scripts/preversion.mjs && npm run typecheck",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
